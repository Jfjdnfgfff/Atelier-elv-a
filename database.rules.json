{
  "rules": {
    ".read": false,
    ".write": false,
    "boutique_store": {
      "boutique_clothes": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["category", "code", "barcode", "purpose", "updatedAt"]
        }
      },
      "boutique_rentals": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["status", "startDate", "expectedReturnDate", "createdAt", "updatedAt", "customerId", "itemId"],
          "$rentalId": {
            ".validate": "newData.hasChildren(['customerName', 'itemId'])"
          }
        }
      },
      "boutique_sales": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["date", "createdAt", "updatedAt"],
          "$saleId": {
            ".validate": "newData.hasChildren(['totalAmount', 'date'])"
          }
        }
      },
      "boutique_expenses": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["date", "category", "createdAt", "supplierId"],
          "$expenseId": {
            ".validate": "newData.hasChildren(['amount', 'category', 'date'])"
          }
        }
      },
      "boutique_credits": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["date", "phone", "relatedRentalId", "supplierDebt", "paid"],
          "$creditId": {
            ".validate": "newData.hasChildren(['customerName', 'amount', 'date'])"
          }
        }
      },
      "boutique_staff_payouts": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["staffId", "date", "createdAt"],
          "$payoutId": {
            ".validate": "newData.hasChildren(['staffId', 'amount', 'date'])"
          }
        }
      },
      "boutique_staff_members": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["name", "role", "active"]
        }
      },
      "boutique_staff_absences": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["staffId", "date", "createdAt"]
        }
      },
      "boutique_customers": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["phone", "name", "createdAt"]
        }
      },
      "boutique_maintenance": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["status", "expectedDeliveryDate", "receivedDate", "createdAt", "orderNumber"],
          "$orderId": {
            ".validate": "newData.hasChildren(['customerName', 'expectedDeliveryDate'])"
          }
        }
      },
      "boutique_suppliers": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["name", "phone"]
        }
      },
      "boutique_seamstresses": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["name", "phone"]
        }
      },
      "boutique_raw_materials": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["name", "type", "code"]
        }
      },
      "boutique_caisse_closures": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["date", "createdAt"],
          "$closureId": {
            ".validate": "newData.hasChildren(['date', 'actualCash'])"
          }
        }
      },
      "boutique_activity_logs": {
        ".read": true,
        ".write": true,
        "records": {
          ".indexOn": ["timestamp", "actionType", "category"]
        }
      },
      "boutique_store_config": {
        ".read": true,
        ".write": true
      },
      "$other": {
        ".read": false,
        ".write": false
      }
    }
  }
}
