{
  "rules": {
    ".read": false,
    ".write": false,
    "boutique_store": {
      ".read": true,
      ".write": true,
      "boutique_clothes": {
        "records": {
          ".indexOn": ["category", "code", "updatedAt"]
        }
      },
      "boutique_rentals": {
        "records": {
          ".indexOn": ["status", "startDate", "expectedReturnDate", "createdAt", "updatedAt"],
          "$rentalId": {
            ".validate": "newData.hasChildren(['customerName', 'itemId'])"
          }
        }
      },
      "boutique_sales": {
        "records": {
          ".indexOn": ["date", "createdAt", "updatedAt"],
          "$saleId": {
            ".validate": "newData.hasChildren(['totalAmount', 'date'])"
          }
        }
      },
      "boutique_expenses": {
        "records": {
          ".indexOn": ["date", "category", "createdAt"],
          "$expenseId": {
            ".validate": "newData.hasChildren(['amount', 'category', 'date'])"
          }
        }
      },
      "boutique_credits": {
        "records": {
          ".indexOn": ["date", "phone", "relatedRentalId"],
          "$creditId": {
            ".validate": "newData.hasChildren(['customerName', 'amount', 'date'])"
          }
        }
      },
      "boutique_staff_payouts": {
        "records": {
          ".indexOn": ["staffId", "date"],
          "$payoutId": {
            ".validate": "newData.hasChildren(['staffId', 'amount', 'date'])"
          }
        }
      },
      "boutique_maintenance": {
        "records": {
          ".indexOn": ["status", "expectedDeliveryDate", "receivedDate"],
          "$orderId": {
            ".validate": "newData.hasChildren(['customerName', 'expectedDeliveryDate'])"
          }
        }
      },
      "boutique_caisse_closures": {
        "records": {
          ".indexOn": ["date"]
        }
      },
      "boutique_activity_logs": {
        "records": {
          ".indexOn": ["timestamp", "actionType", "category"]
        }
      }
    }
  }
}
