rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Direct access to gym collections without requiring authentication
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }
    
    match /packages/{packageId} {
      allow read, write: if isValidId(packageId);
    }
    
    match /expenses/{expenseId} {
      allow read, write: if isValidId(expenseId);
    }
    
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }
    
    match /sales/{saleId} {
      allow read, write: if isValidId(saleId);
    }
    
    match /staffPayouts/{payoutId} {
      allow read, write: if isValidId(payoutId);
    }
    
    match /credits/{creditId} {
      allow read, write: if isValidId(creditId);
    }

    match /coachAbsences/{absenceId} {
      allow read, write: if isValidId(absenceId);
    }
  }
}
